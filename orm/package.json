{
  "name": "@nodec/orm-experiments",
  "version": "0.0.0",
  "private": true,
  "description": "Controlled experiments for a JavaScript ORM with a native execution core",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test",
    "example": "node examples/users.mjs",
    "bench": "node --expose-gc bench/run.mjs",
    "bench:complex": "node --expose-gc bench/complex.mjs"
  }
}
